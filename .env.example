# Answers run on your ChatGPT Plus/Pro plan: sign in on the Settings page.
# Search needs an OpenRouter key for embeddings (https://openrouter.ai/keys); it can also go in Settings.
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# OPENROUTER_MODEL=gpt-6.1-sol        # answers; a vendor/model id would use OpenRouter instead
# FAST_MODEL=gpt-6-luna              # reranking and follow-up rewriting
# EVAL_MODEL=anthropic/claude-sonnet-5.5
# EMBED_MODEL=google/gemini-embedding-2
# OPENROUTER_RPM=18
